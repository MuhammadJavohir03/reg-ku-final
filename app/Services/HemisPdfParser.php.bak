<?php

namespace App\Services;

use Symfony\Component\Process\Process;

/**
 * HEMIS "Baholash qaydnomasi" (1-shakl) PDF faylini o'qib, har bir
 * talaba uchun qator (array) qaytaradi.
 *
 * Haqiqiy pdftotext -layout strukturasi:
 *
 *      NAME_PART_1
 *  N                                   ID  jn on reyting yn umumiy baho
 *      NAME_PART_2          ← odatda O‘G‘LI yoki patronimik davomi
 *      NEXT_NAME_PART_1
 *  N+1                                 ID  ...
 *      NEXT_NAME_PART_2
 */
class HemisPdfParser
{
    private const IGNORE_PATTERN = '/^(№|Talabaning|Reyting|daftarchasining|Semestrda|ballar|ΣJN|ΣON|ΣJN\+ΣON|Baho|imzosi|o[‘\'`]?qituvchi|ko[‘\'`]?rsatkichi|O[‘\'`]?zlashtirish|YN|raqami|Jami talabalar|Fakultet|Kafedra|QO[‘\'`]?QON|BAHOLASH|Fan |Fan:|Fan o|Yakuniy|1-shakl|TURG|dekani|mudiri)/ui';

    // ID (9-15 xona) + 6 ta son
    private const DATA_LINE_PATTERN = '/(?:^|\s)(\d{9,15})\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)\s*$/u';

    /**
     * @return array<int, array{
     *     row_num: ?string,
     *     name: string,
     *     reyting_raqami: string,
     *     jn: float,
     *     on: float,
     *     reyting: float,
     *     yn: float,
     *     umumiy: float,
     *     baho: float,
     * }>
     */
    public function parse(string $pdfPath): array
    {
        $text  = $this->extractLayoutText($pdfPath);
        $lines = preg_split('/\r\n|\r|\n/', $text);
        $n     = count($lines);

        $rows = [];
        $pendingNameParts = [];
        $pendingRowNum    = null;

        for ($i = 0; $i < $n; $i++) {
            $line = trim($lines[$i]);
            if ($line === '') {
                continue;
            }

            // === Ma'lumot qatori (ID + 6 ta son) ===
            if (preg_match(self::DATA_LINE_PATTERN, $line, $m)) {
                $reytingRaqami = $m[1];
                $jn      = (float) $m[2];
                $on      = (float) $m[3];
                $reyting = (float) $m[4];
                $yn      = (float) $m[5];
                $umumiy  = (float) $m[6];
                $baho    = (float) $m[7];

                // Data line o'zidagi prefix
                $idPos  = strpos($line, $reytingRaqami);
                $prefix = $idPos !== false ? trim(substr($line, 0, $idPos)) : '';

                $inlineName = $prefix;
                if (preg_match('/^(\d{1,3})\s*(.*)$/u', $prefix, $pm)) {
                    if ($pendingRowNum === null) {
                        $pendingRowNum = $pm[1];
                    }
                    $inlineName = trim($pm[2]);
                }
                if ($inlineName !== '') {
                    $pendingNameParts[] = $inlineName;
                }

                // Data line dan keyingi birinchi "nomzod" qatorni davom deb olamiz,
                // agar u yangi ism boshlanishiga o'xshamasa.
                if ($i + 1 < $n) {
                    $next = trim($lines[$i + 1]);
                    if ($next !== ''
                        && !preg_match(self::DATA_LINE_PATTERN, $next)
                        && !preg_match(self::IGNORE_PATTERN, $next)
                        && !preg_match('/^\d{1,3}$/u', $next)
                        && !$this->looksLikeNewName($next, $pendingNameParts)
                    ) {
                        $pendingNameParts[] = $next;
                        $i++; // iste'mol qildik
                    }
                }

                $fullName = $this->joinFragments($pendingNameParts);
                $fullName = $this->normalizeName($fullName);

                $rows[] = [
                    'row_num'        => $pendingRowNum,
                    'name'           => $fullName,
                    'reyting_raqami' => $reytingRaqami,
                    'jn'             => $jn,
                    'on'             => $on,
                    'reyting'        => $reyting,
                    'yn'             => $yn,
                    'umumiy'         => $umumiy,
                    'baho'           => $baho,
                ];

                $pendingNameParts = [];
                $pendingRowNum    = null;
                continue;
            }

            // Header / footer
            if (preg_match(self::IGNORE_PATTERN, $line)) {
                continue;
            }

            // Faqat qator raqami
            if (preg_match('/^\d{1,3}$/u', $line)) {
                $pendingRowNum = $line;
                continue;
            }

            // Ism bo'lagi
            $pendingNameParts[] = $line;
        }

        return $rows;
    }

    /**
     * Keyingi qator yangi talaba ismining boshlanishiga o'xshaydimi?
     *
     * Agar oldingi ism bo'laklari allaqachon bor bo'lsa va keyingi qator
     * aniq suffix (O‘G‘LI / QIZI) yoki qisqa bitta so'z bo'lsa — bu davom.
     * Aks holda (ko'p so'zli va familiyaga o'xshash) — yangi ism.
     */
    private function looksLikeNewName(string $line, array $alreadyHaveParts): bool
    {
        // Aniq suffixlar — hech qachon yangi ism emas
        if (preg_match('/^(O[‘\'`ʼ]?G[‘\'`ʼ]?LI|QIZI)$/ui', $line)) {
            return false;
        }

        // Agar hali hech qanday ism bo'lagi yig'ilmagan bo'lsa — bu yangi ism
        if (empty($alreadyHaveParts)) {
            return true;
        }

        // Bitta so'z (bo'shliqsiz) — odatda patronimik davomi
        if (!preg_match('/\s/u', $line)) {
            return false;
        }

        // Ikki so'zli va ikkinchisi O‘G‘LI/QIZI bo'lsa — bu ham davom
        // (masalan: "YO‘LDASHALI O‘G‘LI", "BARXAYOTJON O‘G‘LI")
        if (preg_match('/^\S+\s+(O[‘\'`ʼ]?G[‘\'`ʼ]?LI|QIZI)$/ui', $line)) {
            return false;
        }

        // Qolgan ko'p so'zli qatorlar — yangi ism deb hisoblaymiz
        return true;
    }

    private function joinFragments(array $fragments): string
    {
        $result = '';
        foreach (array_filter($fragments, fn ($f) => trim((string) $f) !== '') as $fragment) {
            $fragment = trim((string) $fragment);
            if ($result !== '' && substr($result, -1) === '-') {
                $result = substr($result, 0, -1) . $fragment;
            } else {
                $result = trim($result . ' ' . $fragment);
            }
        }
        return $result;
    }

    private function normalizeName(string $name): string
    {
        $name = preg_replace('/^\d{1,3}\s+/u', '', $name);
        $name = preg_replace('/\s+/u', ' ', $name);
        return trim($name);
    }

    private function extractLayoutText(string $pdfPath): string
    {
        $process = new Process(['pdftotext', '-layout', $pdfPath, '-']);
        $process->run();

        if (!$process->isSuccessful()) {
            throw new \RuntimeException(
                "PDF faylni o'qib bo'lmadi. Serverda 'poppler-utils' paketi o'rnatilganini tekshiring " .
                "(masalan: sudo apt install poppler-utils). Xatolik: " . $process->getErrorOutput()
            );
        }

        return $process->getOutput();
    }
}